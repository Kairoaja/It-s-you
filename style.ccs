*{
box-sizing:border-box;
margin:0;
padding:0;
}

:root{
--red:#e10600;
--dark:#030303;
--white:#f4f4f4;
--gray:#777;
}

html,body{
width:100%;
height:100%;
}

body{
background:#000;
color:var(--white);
font-family:"Courier New",monospace;
overflow:hidden;
}

/* LOADING */

#loading{
position:fixed;
inset:0;
z-index:9999;
background:#000;
display:flex;
flex-direction:column;
align-items:center;
justify-content:center;
transition:1s;
}

.spider-mark{
width:80px;
height:80px;
border:2px solid var(--red);
display:grid;
place-items:center;
color:var(--red);
font:bold 60px Arial;
transform:skew(-8deg);
box-shadow:0 0 35px #e1060033;
}

#loading p{
margin-top:25px;
font-size:9px;
letter-spacing:4px;
color:#aaa;
}

#loading small{
margin-top:12px;
font-size:7px;
color:#444;
letter-spacing:2px;
}

.loader{
width:220px;
height:2px;
background:#222;
margin-top:20px;
}

.loader span{
display:block;
width:0;
height:100%;
background:var(--red);
animation:load 2.2s forwards;
}

/* GLOBAL */

header{
position:fixed;
top:0;
left:0;
right:0;
z-index:1000;
padding:20px 25px;
border-bottom:1px solid #181818;
display:flex;
justify-content:space-between;
font-size:8px;
letter-spacing:3px;
}

.signal i{
display:inline-block;
width:6px;
height:6px;
border-radius:50%;
background:#4cff72;
box-shadow:0 0 12px #4cff72;
margin-right:7px;
}

.web-lines{
position:fixed;
width:500px;
height:500px;
right:-250px;
top:-220px;
border:1px solid #fff;
border-radius:50%;
opacity:.035;
box-shadow:
0 0 0 70px transparent,
0 0 0 71px #fff,
0 0 0 140px transparent,
0 0 0 141px #fff;
pointer-events:none;
}

.grain{
position:fixed;
inset:0;
z-index:9998;
pointer-events:none;
opacity:.05;
background:
repeating-linear-gradient(
0deg,
transparent 0px,
transparent 3px,
white 4px
);
}

/* PAGES */

.page{
position:absolute;
inset:0;
display:none;
overflow:auto;
}

.page.active{
display:flex;
animation:enter .7s ease;
}

/* HOME */

#home{
justify-content:center;
align-items:center;
background:
radial-gradient(
circle at 50% 50%,
#310000,
#080000 35%,
#000 70%
);
}

.hero{
width:min(850px,90%);
text-align:center;
}

.classified{
color:var(--red);
font-size:8px;
letter-spacing:4px;
}

.fromto{
display:flex;
justify-content:center;
align-items:center;
gap:45px;
margin:35px 0;
}

.fromto div{
display:flex;
flex-direction:column;
gap:8px;
}

.fromto small{
color:#555;
font-size:7px;
letter-spacing:3px;
}

.fromto strong{
font-family:Arial;
font-size:20px;
}

.fromto span{
color:var(--red);
font-size:30px;
}

.hero h1{
font-family:Arial,sans-serif;
font-size:clamp(48px,9vw,100px);
line-height:.82;
letter-spacing:-5px;
}

.hero h1 span{
color:var(--red);
}

.sub{
color:#777;
font-size:11px;
line-height:2;
margin:30px 0;
}

button{
cursor:pointer;
font-family:inherit;
}

.hero button{
background:var(--red);
color:white;
border:0;
padding:17px 25px;
font-weight:bold;
letter-spacing:2px;
}

.hero button:hover{
background:white;
color:black;
}

.hero button b{
margin-left:30px;
}

.tiny{
margin-top:25px;
font-size:7px;
color:#444;
letter-spacing:2px;
}

.tiny span{
color:#4cff72;
}

/* SENSE */

#sense,
#confession{
justify-content:center;
align-items:center;
text-align:center;
background:
radial-gradient(circle,#250000,#000 65%);
}

.center,
.confession{
width:min(700px,90%);
}

.label{
color:#666;
font-size:8px;
letter-spacing:3px;
}

.heart-monitor{
height:100px;
margin:35px 0;
background:
linear-gradient(
90deg,
transparent 0 4%,
#222 4% 4.2%,
transparent 4.2% 10%
);
border-bottom:1px solid #222;
overflow:hidden;
}

.pulse{
width:200%;
height:100%;
background:
linear-gradient(
90deg,
transparent 0 20%,
var(--red) 20.5%,
transparent 21% 25%,
var(--red) 25.5%,
transparent 26%
);
clip-path:
polygon(
0 50%,
20% 50%,
21% 48%,
22% 50%,
23% 20%,
24% 85%,
25% 50%,
40% 50%,
100% 50%
);
animation:ecg 2s linear infinite;
}

.center h2,
.confession h2{
font-family:Arial;
font-size:clamp(40px,8vw,80px);
line-height:.85;
}

.center h2 span,
.confession h2 span{
color:var(--red);
}

.center>p{
color:#666;
line-height:2;
font-size:11px;
margin:25px 0;
}

.heartbeat{
margin:25px auto;
display:flex;
justify-content:center;
gap:15px;
align-items:center;
color:#555;
font-size:9px;
}

.heartbeat span{
color:var(--red);
font-size:25px;
animation:pulse 1s infinite;
}

.center button,
.confession button{
padding:15px 22px;
border:1px solid #444;
background:transparent;
color:white;
letter-spacing:2px;
}

.center button:hover,
.confession button:hover{
border-color:var(--red);
color:var(--red);
}

/* FILE */

#file{
justify-content:center;
align-items:center;
background:#050505;
}

.file{
width:min(800px,90%);
border:1px solid #333;
padding:35px;
position:relative;
background:#080808;
}

.file-top,
.file-bottom{
display:flex;
justify-content:space-between;
font-size:8px;
letter-spacing:2px;
color:#555;
}

.file-top b{
color:var(--red);
}

.file-number{
position:absolute;
right:25px;
top:50px;
font:bold 120px Arial;
color:#ffffff04;
}

.file h2{
font-family:Arial;
font-size:clamp(40px,7vw,70px);
line-height:.8;
margin:70px 0 40px;
}

.file h2 span{
color:var(--red);
}

.facts{
display:grid;
grid-template-columns:1fr 1fr;
border-top:1px solid #222;
border-left:1px solid #222;
}

.facts div{
padding:20px;
border-right:1px solid #222;
border-bottom:1px solid #222;
}

.facts small{
color:#555;
font-size:7px;
letter-spacing:2px;
}

.facts p{
margin-top:12px;
font-size:11px;
}

.facts .red{
color:var(--red);
}

.file-bottom{
margin:25px 0;
}

.file>button{
width:100%;
padding:15px;
background:transparent;
border:1px solid var(--red);
color:var(--red);
letter-spacing:2px;
}

/* QUESTION */

#question{
justify-content:center;
align-items:center;
background:
radial-gradient(circle,#210000,#000 65%);
}

.question{
width:min(750px,90%);
}

.question h2{
font-family:Arial;
font-size:clamp(45px,8vw,85px);
line-height:.82;
margin:30px 0 40px;
}

.question h2 span{
color:var(--red);
}

.answers{
display:grid;
gap:10px;
}

.answers button{
padding:18px;
text-align:left;
background:#080808;
border:1px solid #252525;
color:#999;
}

.answers button:hover{
border-color:var(--red);
color:white;
}

.answers b{
color:var(--red);
margin-right:25px;
}

#questionMessage{
margin-top:15px;
min-height:15px;
font-size:9px;
}

/* CONFESSION */

.big-heart{
color:var(--red);
font-size:75px;
margin:30px 0;
animation:pulse 1.3s infinite;
}

.confession>p{
color:#666;
margin:20px 0 10px;
}

.typing{
min-height:70px;
color:white;
font-size:15px;
line-height:2;
margin-bottom:25px;
}

/* LETTER */

#letter{
justify-content:center;
align-items:center;
background:
radial-gradient(circle,#280000,#000 65%);
}

.letter{
width:min(650px,90%);
max-height:80vh;
overflow:auto;
background:#eeeae2;
color:#181818;
padding:45px 35px;
box-shadow:0 30px 100px #000;
}

.letter-meta{
color:#777;
font-size:7px;
letter-spacing:2px;
line-height:1.8;
}

.letter h2{
font-family:Georgia,serif;
font-size:55px;
line-height:.9;
margin:35px 0;
}

.letter h2 span{
color:var(--red);
}

.letter p{
font-family:Georgia,serif;
line-height:1.9;
margin-bottom:20px;
}

.final-line{
font-weight:bold;
color:#111;
}

.signature{
text-align:right;
font-family:cursive;
font-size:20px;
margin:35px 0;
}

.letter button{
padding:14px 20px;
background:#111;
color:white;
border:0;
}

/* END */

#ending{
justify-content:center;
align-items:center;
text-align:center;
background:
radial-gradient(
circle,
#420000,
#080000 45%,
#000
);
}

.ending{
width:min(800px,90%);
position:relative;
z-index:2;
}

.multiverse{
color:#777;
font-size:8px;
letter-spacing:4px;
}

.S{
width:90px;
height:90px;
border:2px solid var(--red);
display:grid;
place-items:center;
margin:30px auto;
color:var(--red);
font:bold 70px Arial;
transform:skew(-8deg);
box-shadow:0 0 50px #e1060044;
}

.ending h1{
font-family:Arial;
font-size:clamp(45px,9vw,95px);
line-height:.8;
letter-spacing:-4px;
}

.ending h1 span{
color:var(--red);
}

.ending p{
color:#777;
line-height:2;
font-size:11px;
margin:30px 0;
}

.end-heart{
color:var(--red);
font-size:40px;
animation:pulse 1.3s infinite;
}

.ending small{
display:block;
margin-top:25px;
color:#333;
font-size:7px;
letter-spacing:2px;
}

/* ANIMATION */

@keyframes load{
to{width:100%}
}

@keyframes enter{
from{
opacity:0;
transform:scale(1.03);
}
to{
opacity:1;
transform:scale(1);
}
}

@keyframes ecg{
from{transform:translateX(0)}
to{transform:translateX(-50%)}
}

@keyframes pulse{
50%{
transform:scale(1.3);
text-shadow:0 0 30px var(--red);
}
}

@media(max-width:600px){

.hero h1{
    letter-spacing:-3px;
}

.fromto{
    gap:20px;
}

.fromto strong{
    font-size:16px;
}

.facts{
    grid-template-columns:1fr;
}

.file{
    padding:22px;
}

.letter{
    padding:30px 22px;
}

.letter h2{
    font-size:45px;
}

}
